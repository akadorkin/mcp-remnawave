{
  "name": "remnawave-mcp",
  "version": "3.0.0",
  "description": "MCP server for the Remnawave panel (3.4+): compact views, fleet-wide joins, safe dry-run/apply edits of profiles, templates, pools and hosts",
  "type": "module",
  "bin": {
    "remnawave-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "docs:tools": "node scripts/gen-tools-doc.mjs"
  },
  "keywords": [
    "mcp",
    "remnawave",
    "vpn",
    "proxy",
    "xray"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@remnawave/backend-contract": "^3.4.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
